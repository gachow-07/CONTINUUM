# Supabase (Project settings → API). The anon key is safe in the browser: data access is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional (default gpt-4o). Must support structured outputs (json_schema).
OPENAI_MODEL=gpt-4o

# AI request ceilings are enforced in Supabase migration 0004_ai_rate_limits.sql.
# Keep OpenAI project auto-recharge disabled for a separate hard billing ceiling.
