# Supabase (Project settings → API). The anon key is safe in the browser: data access is protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional lower-cost default. Must support structured outputs.
ANTHROPIC_MODEL=claude-haiku-4-5
